# Copy to .env before `docker compose up -d --build`

# MongoDB Atlas: Atlas -> Connect -> Drivers -> copy the string, then add the database name (/myStore) and your password.
# Special characters in the password must be URL-encoded (@ -> %40, / -> %2F, : -> %3A, # -> %23).
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@CLUSTER.xxxxx.mongodb.net/myStore?retryWrites=true&w=majority
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Public URL(s) of the site (comma separated). Only needed if the SPA is served from another origin.
ALLOWED_ORIGINS=http://localhost
WEB_PORT=80
# Used by `docker compose run --rm api npm run seed`
SEED_ADMIN_EMAIL=admin@store.com
SEED_ADMIN_PASSWORD=ChangeMe-Admin1

# Backups (see README → Backup & restore)
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
RETENTION_DAYS=14

# --- Logging ---
# LOG_LEVEL=info            # debug | info | warn | error | silent
# LOG_FORMAT=json          # json (prod default) | pretty
LOG_RETENTION_DAYS=14      # daily log files in LOG_DIR are pruned after this
LOG_DB_RETENTION_DAYS=90   # audit/security/error trail in MongoDB expires after this (TTL index)
