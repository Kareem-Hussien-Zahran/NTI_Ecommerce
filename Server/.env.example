NODE_ENV=development
PORT=3000
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/myStore
# MongoDB Atlas (URL-encode special characters in the password; include the /database name):
# MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@CLUSTER.xxxxx.mongodb.net/myStore?retryWrites=true&w=majority
# Max connections per API process (Atlas tiers limit total connections)
MONGODB_MAX_POOL=20
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Comma separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:4200
# Admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@store.com
SEED_ADMIN_PASSWORD=Admin@12345

# Response cache (in-memory)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=500
